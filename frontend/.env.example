# Optional Vite HTTPS development server. Use locally trusted certificate files.
# Private keys/certificates stay outside the repository.
# DEV_HTTPS_CERT=/absolute/path/localhost.pem
# DEV_HTTPS_KEY=/absolute/path/localhost-key.pem
# DEV_API_TARGET=https://localhost:7001
# Trust the API's CA in Node too: NODE_EXTRA_CA_CERTS=/absolute/path/root-ca.pem
