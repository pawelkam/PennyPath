@PennyPath.Api_HostAddress = https://localhost:0
# Replace port 0 with the HTTPS URL printed by the https launch profile.
# Use a trusted development certificate and a client that retains cookies.
# Sample credentials below are synthetic. Never commit real passwords or tokens.

GET {{PennyPath.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

GET {{PennyPath.Api_HostAddress}}/health
Accept: application/json

###

GET {{PennyPath.Api_HostAddress}}/api/does-not-exist
Accept: application/json

###

# @name anonymousCsrf
GET {{PennyPath.Api_HostAddress}}/api/auth/csrf

###

POST {{PennyPath.Api_HostAddress}}/api/auth/register
Content-Type: application/json
X-CSRF-TOKEN: {{anonymousCsrf.response.body.$.requestToken}}

{"email":"example@example.test","password":"reference passphrase"}

###

# Registration creates no session. Login separately with the anonymous token.
POST {{PennyPath.Api_HostAddress}}/api/auth/login
Content-Type: application/json
X-CSRF-TOKEN: {{anonymousCsrf.response.body.$.requestToken}}

{"email":"example@example.test","password":"reference passphrase"}

###

GET {{PennyPath.Api_HostAddress}}/api/auth/me

###

# Fetch a new request token after the identity changes at login.
# @name authenticatedCsrf
GET {{PennyPath.Api_HostAddress}}/api/auth/csrf

###

# No profile is created by GET; the initial timeZoneId is null.
GET {{PennyPath.Api_HostAddress}}/api/spending/settings

###

GET {{PennyPath.Api_HostAddress}}/api/spending/time-zones

###

# Explicit account choice. Repeating this changes only the time zone.
POST {{PennyPath.Api_HostAddress}}/api/spending/settings
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedCsrf.response.body.$.requestToken}}

{"timeZoneId":"Europe/Warsaw"}

###

GET {{PennyPath.Api_HostAddress}}/api/expense-categories

###

# The API truncates extra fraction digits before saving: 12.349 becomes 12.34.
# The purchase date is literal; past and future dates are allowed.
POST {{PennyPath.Api_HostAddress}}/api/expenses
Content-Type: application/json
X-CSRF-TOKEN: {{authenticatedCsrf.response.body.$.requestToken}}

{"name":"Zakupy","amount":"12.349","purchaseDate":"2026-11-15","categoryId":"food","subcategoryId":null}

###

# Default register and summary both cover the account's current calendar month.
GET {{PennyPath.Api_HostAddress}}/api/spending/overview

###

# History changes the register only. The summary remains for the current month.
GET {{PennyPath.Api_HostAddress}}/api/spending/overview?scope=all&page=1&pageSize=50

###

POST {{PennyPath.Api_HostAddress}}/api/auth/logout
X-CSRF-TOKEN: {{authenticatedCsrf.response.body.$.requestToken}}

###

# Expected 401 after logout; discard the old request token too.
GET {{PennyPath.Api_HostAddress}}/api/auth/me

###
