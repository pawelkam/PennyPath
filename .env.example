# Copy into ~/Serwer/penny-path/deploy/.env; do not commit the real file.
# Keep secrets/ private (0700); postgres-password is 0444 for the non-root app.
POSTGRES_PASSWORD_FILE=./secrets/postgres-password
APP_PORT=8080
# Required: stable LAN IP or hostname, without scheme, port or path.
LAN_HOST=localhost
HTTPS_PORT=8443
# Change both together if this subnet conflicts with an existing Docker network.
EDGE_SUBNET=172.30.90.0/24
PROXY_IP=172.30.90.2
# APP_IMAGE is supplied by deploy.sh and stored in release.env after success.
